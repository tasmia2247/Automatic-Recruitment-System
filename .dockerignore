# Keeps secrets, local data and build output out of the Docker build context.

# Environment files and secrets
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key

# Database data, dumps and uploaded documents
backend/.pgdata
backend/storage
backups
**/*.sql
**/*.sql.gz
**/*.dump
**/*.backup
**/*.bak

# Installed packages and build output (rebuilt inside the image)
**/node_modules
backend/dist
frontend/.next
frontend/next-env.d.ts
**/*.tsbuildinfo

# Not needed in the images
.git
.gitignore
.claude
docs
**/*.md
**/*.log
**/Dockerfile
.dockerignore
docker-compose*.yml
docker
