# SITE_ADDRESS comes from .env. A public domain gets a Let's Encrypt certificate;
# an IP address or a .local/.internal name gets a certificate from Caddy's own CA.
{
	# Browsers send no server name when opening an IP address over HTTPS.
	default_sni {$SITE_ADDRESS}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy web:3000
}
