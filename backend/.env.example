# ---- Ananta ARS API configuration ----
NODE_ENV=development
PORT=4000
# Web app address; opening the API root redirects here
WEB_URL=http://localhost:3000

# PostgreSQL connection used by the application (pgAdmin is only an admin client).
# For the bundled throwaway DB run `npm run db:local` and keep the default below.
DATABASE_URL=postgres://ars:ars_local_dev@localhost:54329/ars

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Password given to all seeded prototype users (change before any shared demo)
SEED_PASSWORD=Ars@2026!
# "Send your CV to" address printed on generated hiring circulars (a job post can override it)
CAREER_EMAIL=career@ananta.com.bd

# File storage for CVs/attachments (private; served only through authorized API routes)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
ALLOWED_CV_EXTENSIONS=pdf,docx,doc,txt

# Display ID formats ({YYYY} = year, {SEQ:n} = zero-padded counter)
ID_FORMAT_REQUISITION=REQ-{YYYY}-{SEQ:6}
ID_FORMAT_VACANCY=VAC-{YYYY}-{SEQ:6}
ID_FORMAT_JOBPOST=JOB-{YYYY}-{SEQ:6}
ID_FORMAT_CANDIDATE=CAND-{SEQ:6}
ID_FORMAT_APPLICATION=APP-{YYYY}-{SEQ:6}
ID_FORMAT_IMPORT=IMP-{YYYY}-{SEQ:5}

# Outgoing email. Leave SMTP_HOST empty to use the dev outbox (emails are written to
# storage/outbox and clearly labelled "dev outbox - not delivered").
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ananta HR <hr@example.com>"

# Background worker poll interval (ms)
WORKER_INTERVAL_MS=3000

# Feature switches (SRS section 25 configurable decisions)
ALLOW_DIRECT_HR_VACANCY=true
REQUISITION_ID_ON=draft
